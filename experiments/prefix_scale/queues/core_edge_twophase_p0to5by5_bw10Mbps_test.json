{
  "_comment": "ndndSIM prefix-scale study for twophase on core_edge (prefix counts: 0, 5). Each run starts fresh. Run with: sudo ./jobs.sh start --fresh prefix_scale/core_edge_twophase_p0to5by5_bw10Mbps_test",
  "selector": "prefix_scale/core_edge_twophase_p0to5by5_bw10Mbps_test",
  "name": "core_edge_twophase_p0to5by5_bw10Mbps_test",
  "experiment": "prefix_scale",
  "topology": "core_edge",
  "mode": "twophase",
  "description": "core_edge prefix-scale study (twophase) for p=0,5. Each run starts fresh.",
  "run_root_template": "experiments/prefix_scale/results/core_edge_twophase_p0to5by5_bw10Mbps_test/{timestamp}",
  "jobs": [
    {
      "name": "build",
      "cmd": "./run.sh build"
    },
    {
      "name": "p=0 twophase",
      "cmd": "./run.sh sim --no-build prefix_scale --topology core_edge --core-disable-prefix-egress-replication --adv-interval 1000 --dead-interval 3000 --window 86400 --prefix-counts 0 --out {run_root}/p0"
    },
    {
      "name": "p=5 twophase",
      "cmd": "./run.sh sim --no-build prefix_scale --topology core_edge --core-disable-prefix-egress-replication --adv-interval 1000 --dead-interval 3000 --window 86400 --prefix-counts 5 --out {run_root}/p5"
    },
    {
      "name": "plot: prefix scale",
      "cmd": "./run.sh as-user python3 experiments/prefix_scale/plot.py --data {run_root} --source-label sim"
    }
  ]
}
