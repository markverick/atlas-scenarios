{
  "_comment": "ndndSIM prefix-scale study for twophase+onephase on core_edge (prefix counts: 0, 500, 1000, 1500, 2000). Each run starts fresh. Run with: sudo ./jobs.sh start --fresh prefix_scale/core_edge_bothphase_p0to2000by500",
  "selector": "prefix_scale/core_edge_bothphase_p0to2000by500",
  "name": "core_edge_bothphase_p0to2000by500",
  "experiment": "prefix_scale",
  "topology": "core_edge",
  "mode": "twophase+onephase",
  "description": "core_edge prefix-scale study (twophase+onephase) for p=0,500,1000,1500,2000. Each run starts fresh.",
  "run_root_template": "experiments/prefix_scale/results/core_edge_bothphase_p0to2000by500/{timestamp}",
  "jobs": [
    {
      "name": "build",
      "cmd": "./run.sh build && ./run.sh --env onephase build"
    },
    {
      "name": "p=0 twophase",
      "cmd": "./run.sh sim --no-build prefix_scale --topology core_edge --core-disable-prefix-egress-replication --window 86400 --prefix-counts 0 --out {run_root}/p0/twophase --conv-window 5.2"
    },
    {
      "name": "p=0 onephase",
      "cmd": "./run.sh --env onephase sim --no-build prefix_scale --topology core_edge --window 86400 --prefix-counts 0 --out {run_root}/p0/onephase --conv-window 5.2"
    },
    {
      "name": "p=500 twophase",
      "cmd": "./run.sh sim --no-build prefix_scale --topology core_edge --core-disable-prefix-egress-replication --window 86400 --prefix-counts 500 --out {run_root}/p500/twophase --conv-window 5.2"
    },
    {
      "name": "p=500 onephase",
      "cmd": "./run.sh --env onephase sim --no-build prefix_scale --topology core_edge --window 86400 --prefix-counts 500 --out {run_root}/p500/onephase --conv-window 5.2"
    },
    {
      "name": "p=1000 twophase",
      "cmd": "./run.sh sim --no-build prefix_scale --topology core_edge --core-disable-prefix-egress-replication --window 86400 --prefix-counts 1000 --out {run_root}/p1000/twophase --conv-window 5.2"
    },
    {
      "name": "p=1000 onephase",
      "cmd": "./run.sh --env onephase sim --no-build prefix_scale --topology core_edge --window 86400 --prefix-counts 1000 --out {run_root}/p1000/onephase --conv-window 5.2"
    },
    {
      "name": "p=1500 twophase",
      "cmd": "./run.sh sim --no-build prefix_scale --topology core_edge --core-disable-prefix-egress-replication --window 86400 --prefix-counts 1500 --out {run_root}/p1500/twophase --conv-window 5.2"
    },
    {
      "name": "p=1500 onephase",
      "cmd": "./run.sh --env onephase sim --no-build prefix_scale --topology core_edge --window 86400 --prefix-counts 1500 --out {run_root}/p1500/onephase --conv-window 5.2"
    },
    {
      "name": "p=2000 twophase",
      "cmd": "./run.sh sim --no-build prefix_scale --topology core_edge --core-disable-prefix-egress-replication --window 86400 --prefix-counts 2000 --out {run_root}/p2000/twophase --conv-window 5.2"
    },
    {
      "name": "p=2000 onephase",
      "cmd": "./run.sh --env onephase sim --no-build prefix_scale --topology core_edge --window 86400 --prefix-counts 2000 --out {run_root}/p2000/onephase --conv-window 5.2"
    },
    {
      "name": "render core-edge plots and summary",
      "cmd": "./run.sh as-user python3 experiments/prefix_scale/plot.py --source-label sim --data {run_root}"
    }
  ]
}
