{
  "_comment": "3-stage ndndSIM prefix-scale study for twophase+onephase on core_edge (prefix counts: 0, 500, 1000, 1500, 2000). Stage 1: DV convergence → snapshot per phase. Stage 2: import snap → announce prefixes → record tables. Run with: sudo ./jobs.sh start --fresh prefix_scale/core_edge_bothphase_0to2000_by500_tables",
  "selector": "prefix_scale/core_edge_bothphase_p0to2000by500",
  "name": "core_edge_bothphase_p0to2000by500",
  "experiment": "prefix_scale",
  "topology": "core_edge",
  "mode": "twophase+onephase",
  "description": "3-stage core_edge prefix-scale table study (twophase+onephase): stage 1 DV convergence snapshot per phase, stage 2 p=0|500|1000|1500|2000 table measurement.",
  "run_root_template": "experiments/prefix_scale/results/core_edge_bothphase_p0to2000by500/{timestamp}",
  "jobs": [
    {
      "name": "build twophase and onephase",
      "cmd": "./run.sh build && ./run.sh --env onephase build"
    },
    {
      "name": "stage1 [twophase]: p=0 DV routing converge → 5.2s silence → export snap",
      "cmd": "./run.sh sim --no-build prefix_scale --topology core_edge --prefix-counts 0 --core-disable-prefix-egress-replication --window 86400 --conv-window 4.2 --snap-export {run_root}/snap-stage1-twophase.json --out {run_root}/stage1-twophase"
    },
    {
      "name": "stage1 [onephase]: p=0 DV routing converge → 5.2s silence → export snap",
      "cmd": "./run.sh --env onephase sim --no-build prefix_scale --topology core_edge --prefix-counts 0 --window 86400 --conv-window 4.2 --snap-export {run_root}/snap-stage1-onephase.json --out {run_root}/stage1-onephase"
    },
    {
      "name": "stage2 [twophase, p=0]: import snap → 5.2s silence (baseline) → record tables",
      "cmd": "./run.sh sim --no-build prefix_scale --topology core_edge --prefix-counts 0 --core-disable-prefix-egress-replication --window 86400 --conv-window 5.2 --snap-export {run_root}/snap-stage2-p0-twophase.json --snap-import {run_root}/snap-stage1-twophase.json --out {run_root}/stage2-p0-twophase"
    },
    {
      "name": "stage2 [onephase, p=0]: import snap → 5.2s silence (baseline) → record tables",
      "cmd": "./run.sh --env onephase sim --no-build prefix_scale --topology core_edge --prefix-counts 0 --window 86400 --conv-window 5.2 --snap-export {run_root}/snap-stage2-p0-onephase.json --snap-import {run_root}/snap-stage1-onephase.json --out {run_root}/stage2-p0-onephase"
    },
    {
      "name": "stage2 [twophase, p=500]: import snap → announce 500 pfx → 5.2s silence → record tables",
      "cmd": "./run.sh sim --no-build prefix_scale --topology core_edge --prefix-counts 500 --core-disable-prefix-egress-replication --window 86400 --snap-export {run_root}/snap-stage2-p500-twophase.json --snap-import {run_root}/snap-stage1-twophase.json --out {run_root}/stage2-p500-twophase"
    },
    {
      "name": "stage2 [onephase, p=500]: import snap → announce 500 pfx → 5.2s silence → record tables",
      "cmd": "./run.sh --env onephase sim --no-build prefix_scale --topology core_edge --prefix-counts 500 --window 86400 --snap-export {run_root}/snap-stage2-p500-onephase.json --snap-import {run_root}/snap-stage1-onephase.json --out {run_root}/stage2-p500-onephase"
    },
    {
      "name": "stage2 [twophase, p=1000]: import snap → announce 1000 pfx → 5.2s silence → record tables",
      "cmd": "./run.sh sim --no-build prefix_scale --topology core_edge --prefix-counts 1000 --core-disable-prefix-egress-replication --window 86400 --snap-export {run_root}/snap-stage2-p1000-twophase.json --snap-import {run_root}/snap-stage1-twophase.json --out {run_root}/stage2-p1000-twophase"
    },
    {
      "name": "stage2 [onephase, p=1000]: import snap → announce 1000 pfx → 5.2s silence → record tables",
      "cmd": "./run.sh --env onephase sim --no-build prefix_scale --topology core_edge --prefix-counts 1000 --window 86400 --snap-export {run_root}/snap-stage2-p1000-onephase.json --snap-import {run_root}/snap-stage1-onephase.json --out {run_root}/stage2-p1000-onephase"
    },
    {
      "name": "stage2 [twophase, p=1500]: import snap → announce 1500 pfx → 5.2s silence → record tables",
      "cmd": "./run.sh sim --no-build prefix_scale --topology core_edge --prefix-counts 1500 --core-disable-prefix-egress-replication --window 86400 --snap-export {run_root}/snap-stage2-p1500-twophase.json --snap-import {run_root}/snap-stage1-twophase.json --out {run_root}/stage2-p1500-twophase"
    },
    {
      "name": "stage2 [onephase, p=1500]: import snap → announce 1500 pfx → 5.2s silence → record tables",
      "cmd": "./run.sh --env onephase sim --no-build prefix_scale --topology core_edge --prefix-counts 1500 --window 86400 --snap-export {run_root}/snap-stage2-p1500-onephase.json --snap-import {run_root}/snap-stage1-onephase.json --out {run_root}/stage2-p1500-onephase"
    },
    {
      "name": "stage2 [twophase, p=2000]: import snap → announce 2000 pfx → 5.2s silence → record tables",
      "cmd": "./run.sh sim --no-build prefix_scale --topology core_edge --prefix-counts 2000 --core-disable-prefix-egress-replication --window 86400 --snap-export {run_root}/snap-stage2-p2000-twophase.json --snap-import {run_root}/snap-stage1-twophase.json --out {run_root}/stage2-p2000-twophase"
    },
    {
      "name": "stage2 [onephase, p=2000]: import snap → announce 2000 pfx → 5.2s silence → record tables",
      "cmd": "./run.sh --env onephase sim --no-build prefix_scale --topology core_edge --prefix-counts 2000 --window 86400 --snap-export {run_root}/snap-stage2-p2000-onephase.json --snap-import {run_root}/snap-stage1-onephase.json --out {run_root}/stage2-p2000-onephase"
    },
    {
      "name": "render core-edge plots and summary",
      "cmd": "./run.sh as-user python3 experiments/prefix_scale/plot.py --source-label sim --data {run_root}"
    }
  ]
}
