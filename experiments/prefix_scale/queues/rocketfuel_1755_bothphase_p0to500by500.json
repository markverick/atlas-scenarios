{
  "_comment": "3-stage ndndSIM prefix-scale study for twophase+onephase on Rocketfuel AS 1755, p500 only. Stage 1: DV convergence → snapshot (per phase). Stage 2: p0 baseline + p500, import snap → announce prefixes → record tables. Run with: sudo ./jobs.sh start --fresh prefix_scale/rocketfuel_1755_bothphase_p500only",
  "selector": "prefix_scale/rocketfuel_1755_bothphase_p0to500by500",
  "name": "rocketfuel_1755_bothphase_p0to500by500",
  "experiment": "prefix_scale",
  "topology": "rocketfuel_1755",
  "mode": "twophase+onephase",
  "description": "3-stage Rocketfuel AS 1755 prefix-scale table study (twophase+onephase), p500 only: stage 1 DV convergence snapshot per phase, stage 2 p0 baseline and p500 measurement.",
  "run_root_template": "experiments/prefix_scale/results/rocketfuel_1755_bothphase_p0to500by500/{timestamp}",
  "jobs": [
    {
      "name": "build twophase and onephase",
      "cmd": "./run.sh build && ./run.sh --env onephase build"
    },
    {
      "name": "stage1: DV convergence snapshot (twophase, 0 prefixes)",
      "cmd": "./run.sh sim --no-build prefix_scale --topology rocketfuel_1755 --prefix-counts 0 --core-disable-prefix-egress-replication --adv-interval 1000 --dead-interval 3000 --window 86400 --conv-window 4.2 --snap-export {run_root}/snap-stage1-twophase.json --out {run_root}/stage1-twophase"
    },
    {
      "name": "stage1: DV convergence snapshot (onephase, 0 prefixes)",
      "cmd": "./run.sh --env onephase sim --no-build prefix_scale --topology rocketfuel_1755 --prefix-counts 0 --adv-interval 1000 --dead-interval 3000 --window 86400 --snap-export {run_root}/snap-stage1-onephase.json --out {run_root}/stage1-onephase"
    },
    {
      "name": "stage2: twophase prefix table measurement p0 (import DV snap)",
      "cmd": "./run.sh sim --no-build prefix_scale --topology rocketfuel_1755 --prefix-counts 0 --core-disable-prefix-egress-replication --adv-interval 1000 --dead-interval 3000 --window 86400 --conv-window 5.2 --snap-import {run_root}/snap-stage1-twophase.json --snap-export {run_root}/snap-stage2-p0-twophase.json --out {run_root}/stage2-p0-twophase"
    },
    {
      "name": "stage2: onephase prefix table measurement p0 (import DV snap)",
      "cmd": "./run.sh --env onephase sim --no-build prefix_scale --topology rocketfuel_1755 --prefix-counts 0 --adv-interval 1000 --dead-interval 3000 --window 86400 --snap-import {run_root}/snap-stage1-onephase.json --snap-export {run_root}/snap-stage2-p0-onephase.json --out {run_root}/stage2-p0-onephase"
    },
    {
      "name": "stage2: twophase prefix table measurement p500 (import DV snap)",
      "cmd": "./run.sh sim --no-build prefix_scale --topology rocketfuel_1755 --prefix-counts 500 --core-disable-prefix-egress-replication --adv-interval 1000 --dead-interval 3000 --window 86400 --snap-import {run_root}/snap-stage1-twophase.json --snap-export {run_root}/snap-stage2-p500-twophase.json --out {run_root}/stage2-p500-twophase"
    },
    {
      "name": "stage2: onephase prefix table measurement p500 (import DV snap)",
      "cmd": "./run.sh --env onephase sim --no-build prefix_scale --topology rocketfuel_1755 --prefix-counts 500 --adv-interval 1000 --dead-interval 3000 --window 86400 --snap-import {run_root}/snap-stage1-onephase.json --snap-export {run_root}/snap-stage2-p500-onephase.json --out {run_root}/stage2-p500-onephase"
    },
    {
      "name": "render rocketfuel_1755 bothphase p500only plots",
      "cmd": "./run.sh as-user python3 experiments/prefix_scale/plot.py --source-label sim --data {run_root}"
    }
  ]
}
