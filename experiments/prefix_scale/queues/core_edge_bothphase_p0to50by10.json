{
  "_comment": "ndndSIM prefix-scale study for twophase+onephase on core_edge (prefix counts: 0, 10, 20, 30, 40, 50). Each run starts fresh. Run with: sudo ./jobs.sh start --fresh prefix_scale/core_edge_bothphase_p0to50by10",
  "selector": "prefix_scale/core_edge_bothphase_p0to50by10",
  "name": "core_edge_bothphase_p0to50by10",
  "experiment": "prefix_scale",
  "topology": "core_edge",
  "mode": "twophase+onephase",
  "description": "core_edge prefix-scale study (twophase+onephase) for p=0,10,20,30,40,50. Each run starts fresh.",
  "run_root_template": "experiments/prefix_scale/results/core_edge_bothphase_p0to50by10/{timestamp}",
  "jobs": [
    {
      "name": "build",
      "cmd": "./run.sh build && ./run.sh --env onephase build"
    },
    {
      "name": "p=0 twophase",
      "cmd": "./run.sh sim --no-build prefix_scale --topology core_edge --core-disable-prefix-egress-replication --window 86400 --prefix-counts 0 --out {run_root}/p0 --conv-window 5.2"
    },
    {
      "name": "p=0 onephase",
      "cmd": "./run.sh --env onephase sim --no-build prefix_scale --topology core_edge --window 86400 --prefix-counts 0 --out {run_root}/p0 --conv-window 5.2"
    },
    {
      "name": "p=10 twophase",
      "cmd": "./run.sh sim --no-build prefix_scale --topology core_edge --core-disable-prefix-egress-replication --window 86400 --prefix-counts 10 --out {run_root}/p10 --conv-window 5.2"
    },
    {
      "name": "p=10 onephase",
      "cmd": "./run.sh --env onephase sim --no-build prefix_scale --topology core_edge --window 86400 --prefix-counts 10 --out {run_root}/p10 --conv-window 5.2"
    },
    {
      "name": "p=20 twophase",
      "cmd": "./run.sh sim --no-build prefix_scale --topology core_edge --core-disable-prefix-egress-replication --window 86400 --prefix-counts 20 --out {run_root}/p20 --conv-window 5.2"
    },
    {
      "name": "p=20 onephase",
      "cmd": "./run.sh --env onephase sim --no-build prefix_scale --topology core_edge --window 86400 --prefix-counts 20 --out {run_root}/p20 --conv-window 5.2"
    },
    {
      "name": "p=30 twophase",
      "cmd": "./run.sh sim --no-build prefix_scale --topology core_edge --core-disable-prefix-egress-replication --window 86400 --prefix-counts 30 --out {run_root}/p30 --conv-window 5.2"
    },
    {
      "name": "p=30 onephase",
      "cmd": "./run.sh --env onephase sim --no-build prefix_scale --topology core_edge --window 86400 --prefix-counts 30 --out {run_root}/p30 --conv-window 5.2"
    },
    {
      "name": "p=40 twophase",
      "cmd": "./run.sh sim --no-build prefix_scale --topology core_edge --core-disable-prefix-egress-replication --window 86400 --prefix-counts 40 --out {run_root}/p40 --conv-window 5.2"
    },
    {
      "name": "p=40 onephase",
      "cmd": "./run.sh --env onephase sim --no-build prefix_scale --topology core_edge --window 86400 --prefix-counts 40 --out {run_root}/p40 --conv-window 5.2"
    },
    {
      "name": "p=50 twophase",
      "cmd": "./run.sh sim --no-build prefix_scale --topology core_edge --core-disable-prefix-egress-replication --window 86400 --prefix-counts 50 --out {run_root}/p50 --conv-window 5.2"
    },
    {
      "name": "p=50 onephase",
      "cmd": "./run.sh --env onephase sim --no-build prefix_scale --topology core_edge --window 86400 --prefix-counts 50 --out {run_root}/p50 --conv-window 5.2"
    },
    {
      "name": "render core-edge plots and summary",
      "cmd": "./run.sh as-user python3 experiments/prefix_scale/plot.py --source-label sim --data {run_root}"
    }
  ]
}
