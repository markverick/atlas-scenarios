{
  "_comment": "ndndSIM prefix-scale study for twophase on core_edge (prefix counts: 500, 1000, 1500, 2000). Each run starts fresh. Run with: sudo ./jobs.sh start --fresh prefix_scale/core_edge_twophase_p0to2000by500",
  "selector": "prefix_scale/core_edge_twophase_p0to2000by500",
  "name": "core_edge_twophase_p0to2000by500",
  "experiment": "prefix_scale",
  "topology": "core_edge",
  "mode": "twophase",
  "description": "core_edge prefix-scale study (twophase) for p=500,1000,1500,2000. Each run starts fresh.",
  "run_root_template": "experiments/prefix_scale/results/core_edge_twophase_p0to2000by500/{timestamp}",
  "jobs": [
    {
      "name": "build",
      "cmd": "./run.sh build"
    },
    {
      "name": "p=500 twophase",
      "cmd": "./run.sh sim --no-build prefix_scale --topology core_edge --core-disable-prefix-egress-replication --adv-interval 1000 --dead-interval 3000 --window 86400 --prefix-counts 500 --out {run_root}/p500"
    },
    {
      "name": "p=1000 twophase",
      "cmd": "./run.sh sim --no-build prefix_scale --topology core_edge --core-disable-prefix-egress-replication --adv-interval 1000 --dead-interval 3000 --window 86400 --prefix-counts 1000 --out {run_root}/p1000"
    },
    {
      "name": "p=1500 twophase",
      "cmd": "./run.sh sim --no-build prefix_scale --topology core_edge --core-disable-prefix-egress-replication --adv-interval 1000 --dead-interval 3000 --window 86400 --prefix-counts 1500 --out {run_root}/p1500"
    },
    {
      "name": "p=2000 twophase",
      "cmd": "./run.sh sim --no-build prefix_scale --topology core_edge --core-disable-prefix-egress-replication --adv-interval 1000 --dead-interval 3000 --window 86400 --prefix-counts 2000 --out {run_root}/p2000"
    },
    {
      "name": "render core_edge twophase plots",
      "cmd": "./run.sh as-user python3 experiments/prefix_scale/plot.py --source-label sim --data {run_root}"
    }
  ]
}
