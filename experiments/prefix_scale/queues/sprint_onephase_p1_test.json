{
  "_comment": "Sprint one-phase single-prefix test queue for sim+emu, snapshots disabled. Run with: sudo ./jobs.sh start --fresh prefix_scale/sprint_onephase_1prefix_test",
  "selector": "prefix_scale/sprint_onephase_p1_test",
  "name": "sprint_onephase_p1_test",
  "experiment": "prefix_scale",
  "topology": "sprint",
  "mode": "onephase",
  "description": "Sprint one-phase single-prefix test run for sim and emu",
  "run_root_template": "experiments/prefix_scale/results/sprint_onephase_p1_test/{timestamp}",
  "jobs": [
    {
      "name": "build",
      "cmd": "./run.sh build"
    },
    {
      "name": "sim one_phase p1",
      "cmd": "./run.sh sim --no-build churn.py --config experiments/prefix_scale/scenarios/sprint_onephase_sim_1prefix_test.json --out {run_root}/sim --mode one_phase --prefixes 1 --append"
    },
    {
      "name": "emu one_phase p1",
      "cmd": "./run.sh emu --no-build churn.py --config experiments/prefix_scale/scenarios/sprint_onephase_emu_1prefix_test.json --out {run_root}/emu --mode one_phase --prefixes 1 --append"
    },
    {
      "name": "plot sim-vs-emu p1 test",
      "cmd": "python3 experiments/prefix_scale/plot.py --source-label sim --data {run_root}/emu --data2 {run_root}/sim --out {run_root}/compare"
    }
  ]
}
