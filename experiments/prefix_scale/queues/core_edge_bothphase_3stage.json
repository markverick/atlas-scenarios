{
  "_comment": "3-stage ndndSIM prefix-scale study for twophase+onephase on the core/edge topology. Stage 1: DV convergence → snapshot (per phase). Stage 2: per prefix count, import snap → announce prefixes → record tables. Run with: sudo ./jobs.sh start --fresh prefix_scale/core_edge_bothphase_3stage",
  "selector": "prefix_scale/core_edge_bothphase_3stage",
  "name": "core_edge_bothphase_3stage",
  "experiment": "prefix_scale",
  "topology": "core_edge",
  "mode": "twophase+onephase",
  "description": "3-stage core/edge prefix-scale table study (twophase+onephase): stage 1 DV convergence snapshot per phase, stage 2 per-prefix table measurement.",
  "run_root_template": "experiments/prefix_scale/results/core_edge_bothphase_3stage/{timestamp}",
  "jobs": [
    {
      "name": "build twophase and onephase",
      "cmd": "./run.sh build && ./run.sh --env onephase build"
    },
    {
      "name": "stage1: DV convergence snapshot (twophase, 0 prefixes)",
      "cmd": "./run.sh sim --no-build prefix_scale --topology core_edge --prefix-counts 0 --core-disable-prefix-egress-replication --adv-interval 1000 --dead-interval 3000 --window 200 --snap-export {run_root}/snap-stage1-twophase.json --out {run_root}/stage1-twophase"
    },
    {
      "name": "stage1: DV convergence snapshot (onephase, 0 prefixes)",
      "cmd": "./run.sh --env onephase sim --no-build prefix_scale --topology core_edge --prefix-counts 0 --adv-interval 1000 --dead-interval 3000 --window 200 --snap-export {run_root}/snap-stage1-onephase.json --out {run_root}/stage1-onephase"
    },
    {
      "name": "stage2: twophase prefix table measurement p500 (import DV snap)",
      "cmd": "./run.sh sim --no-build prefix_scale --topology core_edge --prefix-counts 500 --core-disable-prefix-egress-replication --adv-interval 1000 --dead-interval 3000 --window 15 --snap-import {run_root}/snap-stage1-twophase.json --snap-export {run_root}/snap-stage2-p500-twophase.json --out {run_root}/stage2-p500-twophase"
    },
    {
      "name": "stage2: onephase prefix table measurement p500 (import DV snap)",
      "cmd": "./run.sh --env onephase sim --no-build prefix_scale --topology core_edge --prefix-counts 500 --adv-interval 1000 --dead-interval 3000 --window 15 --snap-import {run_root}/snap-stage1-onephase.json --snap-export {run_root}/snap-stage2-p500-onephase.json --out {run_root}/stage2-p500-onephase"
    },
    {
      "name": "stage2: twophase prefix table measurement p1000 (import DV snap)",
      "cmd": "./run.sh sim --no-build prefix_scale --topology core_edge --prefix-counts 1000 --core-disable-prefix-egress-replication --adv-interval 1000 --dead-interval 3000 --window 15 --snap-import {run_root}/snap-stage1-twophase.json --snap-export {run_root}/snap-stage2-p1000-twophase.json --out {run_root}/stage2-p1000-twophase"
    },
    {
      "name": "stage2: onephase prefix table measurement p1000 (import DV snap)",
      "cmd": "./run.sh --env onephase sim --no-build prefix_scale --topology core_edge --prefix-counts 1000 --adv-interval 1000 --dead-interval 3000 --window 15 --snap-import {run_root}/snap-stage1-onephase.json --snap-export {run_root}/snap-stage2-p1000-onephase.json --out {run_root}/stage2-p1000-onephase"
    },
    {
      "name": "stage2: twophase prefix table measurement p1500 (import DV snap)",
      "cmd": "./run.sh sim --no-build prefix_scale --topology core_edge --prefix-counts 1500 --core-disable-prefix-egress-replication --adv-interval 1000 --dead-interval 3000 --window 15 --snap-import {run_root}/snap-stage1-twophase.json --snap-export {run_root}/snap-stage2-p1500-twophase.json --out {run_root}/stage2-p1500-twophase"
    },
    {
      "name": "stage2: onephase prefix table measurement p1500 (import DV snap)",
      "cmd": "./run.sh --env onephase sim --no-build prefix_scale --topology core_edge --prefix-counts 1500 --adv-interval 1000 --dead-interval 3000 --window 15 --snap-import {run_root}/snap-stage1-onephase.json --snap-export {run_root}/snap-stage2-p1500-onephase.json --out {run_root}/stage2-p1500-onephase"
    },
    {
      "name": "stage2: twophase prefix table measurement p2000 (import DV snap)",
      "cmd": "./run.sh sim --no-build prefix_scale --topology core_edge --prefix-counts 2000 --core-disable-prefix-egress-replication --adv-interval 1000 --dead-interval 3000 --window 15 --snap-import {run_root}/snap-stage1-twophase.json --snap-export {run_root}/snap-stage2-p2000-twophase.json --out {run_root}/stage2-p2000-twophase"
    },
    {
      "name": "stage2: onephase prefix table measurement p2000 (import DV snap)",
      "cmd": "./run.sh --env onephase sim --no-build prefix_scale --topology core_edge --prefix-counts 2000 --adv-interval 1000 --dead-interval 3000 --window 15 --snap-import {run_root}/snap-stage1-onephase.json --snap-export {run_root}/snap-stage2-p2000-onephase.json --out {run_root}/stage2-p2000-onephase"
    },
    {
      "name": "render core_edge bothphase plots",
      "cmd": "./run.sh as-user python3 experiments/prefix_scale/plot.py --data {run_root}"
    }
  ]
}
