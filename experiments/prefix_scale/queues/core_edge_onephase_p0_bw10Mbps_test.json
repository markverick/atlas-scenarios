{
  "_comment": "ndndSIM prefix-scale study for twophase+onephase on core_edge (prefix counts: 0). Each run starts fresh. Run with: sudo ./jobs.sh start --fresh prefix_scale/core_edge_onephase_p0_bw10Mbps_test",
  "selector": "prefix_scale/core_edge_onephase_p0_bw10Mbps_test",
  "name": "core_edge_onephase_p0_bw10Mbps_test",
  "experiment": "prefix_scale",
  "topology": "core_edge",
  "mode": "twophase+onephase",
  "description": "core_edge prefix-scale study (twophase+onephase) for p=0. Each run starts fresh.",
  "run_root_template": "experiments/prefix_scale/results/core_edge_onephase_p0_bw10Mbps_test/{timestamp}",
  "jobs": [
    {
      "name": "build",
      "cmd": "./run.sh build && ./run.sh --env onephase build"
    },
    {
      "name": "p=0 twophase",
      "cmd": "./run.sh sim --no-build prefix_scale --topology core_edge --adv-interval 1000 --dead-interval 3000 --window 86400 --prefix-counts 0 --out {run_root}/p0"
    },
    {
      "name": "p=0 onephase",
      "cmd": "./run.sh --env onephase sim --no-build prefix_scale --topology core_edge --adv-interval 1000 --dead-interval 3000 --window 86400 --prefix-counts 0 --out {run_root}/p0"
    },
    {
      "name": "plot: I/O graph",
      "cmd": "./run.sh as-user python3 experiments/prefix_scale/make_run_io_graph.py --data {run_root} --bw 10"
    }
  ]
}
