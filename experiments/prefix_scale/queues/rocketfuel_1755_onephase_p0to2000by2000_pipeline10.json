{
  "_comment": "ndndSIM prefix-scale study for onephase on rocketfuel_1755 (prefix counts: 0, 2000). Each run starts fresh. Run with: sudo ./jobs.sh start --fresh prefix_scale/rocketfuel_1755_onephase_p0to2000by2000_pipeline10",
  "selector": "prefix_scale/rocketfuel_1755_onephase_p0to2000by2000_pipeline10",
  "name": "rocketfuel_1755_onephase_p0to2000by2000_pipeline10",
  "experiment": "prefix_scale",
  "topology": "rocketfuel_1755",
  "mode": "onephase",
  "description": "rocketfuel_1755 prefix-scale study (onephase) for p=0,2000. Each run starts fresh.",
  "run_root_template": "experiments/prefix_scale/results/rocketfuel_1755_onephase_p0to2000by2000_pipeline10/{timestamp}",
  "jobs": [
    {
      "name": "build",
      "cmd": "./run.sh --env onephase build"
    },
    {
      "name": "p=0 onephase",
      "cmd": "NDNDSIM_SVS_PIPELINE=10 ./run.sh --env onephase sim --no-build prefix_scale --topology rocketfuel_1755 --adv-interval 1000 --dead-interval 3000 --window 86400 --prefix-counts 0 --out {run_root}/p0"
    },
    {
      "name": "p=2000 onephase",
      "cmd": "NDNDSIM_SVS_PIPELINE=10 ./run.sh --env onephase sim --no-build prefix_scale --topology rocketfuel_1755 --adv-interval 1000 --dead-interval 3000 --window 86400 --prefix-counts 2000 --out {run_root}/p2000"
    }
  ]
}
