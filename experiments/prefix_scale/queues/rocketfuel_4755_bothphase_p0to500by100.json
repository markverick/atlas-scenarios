{
  "_comment": "ndndSIM prefix-scale study for twophase+onephase on rocketfuel_4755 (prefix counts: 0, 100, 200, 300, 400, 500). Each run starts fresh. Run with: sudo ./jobs.sh start --fresh prefix_scale/rocketfuel_4755_bothphase_p0to500by100",
  "selector": "prefix_scale/rocketfuel_4755_bothphase_p0to500by100",
  "name": "rocketfuel_4755_bothphase_p0to500by100",
  "experiment": "prefix_scale",
  "topology": "rocketfuel_4755",
  "mode": "twophase+onephase",
  "description": "rocketfuel_4755 prefix-scale study (twophase+onephase) for p=0,100,200,300,400,500. Each run starts fresh.",
  "run_root_template": "experiments/prefix_scale/results/rocketfuel_4755_bothphase_p0to500by100/{timestamp}",
  "jobs": [
    {
      "name": "build",
      "cmd": "./run.sh build && ./run.sh --env onephase build"
    },
    {
      "name": "p=0 twophase",
      "cmd": "./run.sh sim --no-build prefix_scale --topology rocketfuel_4755 --core-disable-prefix-egress-replication --window 86400 --prefix-counts 0 --out {run_root}/p0 --conv-window 5.2"
    },
    {
      "name": "p=0 onephase",
      "cmd": "./run.sh --env onephase sim --no-build prefix_scale --topology rocketfuel_4755 --window 86400 --prefix-counts 0 --out {run_root}/p0 --conv-window 5.2"
    },
    {
      "name": "p=100 twophase",
      "cmd": "./run.sh sim --no-build prefix_scale --topology rocketfuel_4755 --core-disable-prefix-egress-replication --window 86400 --prefix-counts 100 --out {run_root}/p100 --conv-window 5.2"
    },
    {
      "name": "p=100 onephase",
      "cmd": "./run.sh --env onephase sim --no-build prefix_scale --topology rocketfuel_4755 --window 86400 --prefix-counts 100 --out {run_root}/p100 --conv-window 5.2"
    },
    {
      "name": "p=200 twophase",
      "cmd": "./run.sh sim --no-build prefix_scale --topology rocketfuel_4755 --core-disable-prefix-egress-replication --window 86400 --prefix-counts 200 --out {run_root}/p200 --conv-window 5.2"
    },
    {
      "name": "p=200 onephase",
      "cmd": "./run.sh --env onephase sim --no-build prefix_scale --topology rocketfuel_4755 --window 86400 --prefix-counts 200 --out {run_root}/p200 --conv-window 5.2"
    },
    {
      "name": "p=300 twophase",
      "cmd": "./run.sh sim --no-build prefix_scale --topology rocketfuel_4755 --core-disable-prefix-egress-replication --window 86400 --prefix-counts 300 --out {run_root}/p300 --conv-window 5.2"
    },
    {
      "name": "p=300 onephase",
      "cmd": "./run.sh --env onephase sim --no-build prefix_scale --topology rocketfuel_4755 --window 86400 --prefix-counts 300 --out {run_root}/p300 --conv-window 5.2"
    },
    {
      "name": "p=400 twophase",
      "cmd": "./run.sh sim --no-build prefix_scale --topology rocketfuel_4755 --core-disable-prefix-egress-replication --window 86400 --prefix-counts 400 --out {run_root}/p400 --conv-window 5.2"
    },
    {
      "name": "p=400 onephase",
      "cmd": "./run.sh --env onephase sim --no-build prefix_scale --topology rocketfuel_4755 --window 86400 --prefix-counts 400 --out {run_root}/p400 --conv-window 5.2"
    },
    {
      "name": "p=500 twophase",
      "cmd": "./run.sh sim --no-build prefix_scale --topology rocketfuel_4755 --core-disable-prefix-egress-replication --window 86400 --prefix-counts 500 --out {run_root}/p500 --conv-window 5.2"
    },
    {
      "name": "p=500 onephase",
      "cmd": "./run.sh --env onephase sim --no-build prefix_scale --topology rocketfuel_4755 --window 86400 --prefix-counts 500 --out {run_root}/p500 --conv-window 5.2"
    },
    {
      "name": "render rocketfuel 4755 plots and summary",
      "cmd": "./run.sh as-user python3 experiments/prefix_scale/plot.py --source-label sim --data {run_root}"
    }
  ]
}
