{
  "_comment": "ndndSIM prefix-scale study for twophase+onephase on rocketfuel_2914 (prefix counts: 0, 500, 1000, 1500, 2000). Each run starts fresh. Run with: sudo ./jobs.sh start --fresh prefix_scale/rocketfuel_2914_bothphase_p0to2000by500",
  "selector": "prefix_scale/rocketfuel_2914_bothphase_p0to2000by500",
  "name": "rocketfuel_2914_bothphase_p0to2000by500",
  "experiment": "prefix_scale",
  "topology": "rocketfuel_2914",
  "mode": "twophase+onephase",
  "description": "rocketfuel_2914 prefix-scale study (twophase+onephase) for p=0,500,1000,1500,2000. Each run starts fresh.",
  "run_root_template": "experiments/prefix_scale/results/rocketfuel_2914_bothphase_p0to2000by500/{timestamp}",
  "jobs": [
    {
      "name": "build",
      "cmd": "./run.sh build && ./run.sh --env onephase build"
    },
    {
      "name": "p=0 twophase",
      "cmd": "./run.sh sim --no-build prefix_scale --topology rocketfuel_2914 --core-disable-prefix-egress-replication --adv-interval 1000 --dead-interval 3000 --window 86400 --prefix-counts 0 --out {run_root}/p0 --conv-window 5.2"
    },
    {
      "name": "p=0 onephase",
      "cmd": "./run.sh --env onephase sim --no-build prefix_scale --topology rocketfuel_2914 --adv-interval 1000 --dead-interval 3000 --window 86400 --prefix-counts 0 --out {run_root}/p0 --conv-window 5.2"
    },
    {
      "name": "p=500 twophase",
      "cmd": "./run.sh sim --no-build prefix_scale --topology rocketfuel_2914 --core-disable-prefix-egress-replication --adv-interval 1000 --dead-interval 3000 --window 86400 --prefix-counts 500 --out {run_root}/p500 --conv-window 5.2"
    },
    {
      "name": "p=500 onephase",
      "cmd": "./run.sh --env onephase sim --no-build prefix_scale --topology rocketfuel_2914 --adv-interval 1000 --dead-interval 3000 --window 86400 --prefix-counts 500 --out {run_root}/p500 --conv-window 5.2"
    },
    {
      "name": "p=1000 twophase",
      "cmd": "./run.sh sim --no-build prefix_scale --topology rocketfuel_2914 --core-disable-prefix-egress-replication --adv-interval 1000 --dead-interval 3000 --window 86400 --prefix-counts 1000 --out {run_root}/p1000 --conv-window 5.2"
    },
    {
      "name": "p=1000 onephase",
      "cmd": "./run.sh --env onephase sim --no-build prefix_scale --topology rocketfuel_2914 --adv-interval 1000 --dead-interval 3000 --window 86400 --prefix-counts 1000 --out {run_root}/p1000 --conv-window 5.2"
    },
    {
      "name": "p=1500 twophase",
      "cmd": "./run.sh sim --no-build prefix_scale --topology rocketfuel_2914 --core-disable-prefix-egress-replication --adv-interval 1000 --dead-interval 3000 --window 86400 --prefix-counts 1500 --out {run_root}/p1500 --conv-window 5.2"
    },
    {
      "name": "p=1500 onephase",
      "cmd": "./run.sh --env onephase sim --no-build prefix_scale --topology rocketfuel_2914 --adv-interval 1000 --dead-interval 3000 --window 86400 --prefix-counts 1500 --out {run_root}/p1500 --conv-window 5.2"
    },
    {
      "name": "p=2000 twophase",
      "cmd": "./run.sh sim --no-build prefix_scale --topology rocketfuel_2914 --core-disable-prefix-egress-replication --adv-interval 1000 --dead-interval 3000 --window 86400 --prefix-counts 2000 --out {run_root}/p2000 --conv-window 5.2"
    },
    {
      "name": "p=2000 onephase",
      "cmd": "./run.sh --env onephase sim --no-build prefix_scale --topology rocketfuel_2914 --adv-interval 1000 --dead-interval 3000 --window 86400 --prefix-counts 2000 --out {run_root}/p2000 --conv-window 5.2"
    },
    {
      "name": "render rocketfuel 2914 plots and summary",
      "cmd": "./run.sh as-user python3 experiments/prefix_scale/plot.py --source-label sim --data {run_root}"
    }
  ]
}
