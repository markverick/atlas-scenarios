{
  "_comment": "Large Rocketfuel AS 2914 prefix-scale table study for twophase and onephase at 500-prefix steps. Run with: sudo ./jobs.sh start --fresh prefix_scale/rocketfuel_2914_bothphase_0to2000_by500_tables",
  "selector": "prefix_scale/rocketfuel_2914_bothphase_0to2000_by500_tables",
  "name": "rocketfuel_2914_bothphase_0to2000_by500_tables",
  "experiment": "prefix_scale",
  "topology": "rocketfuel_2914",
  "mode": "twophase+onephase",
  "description": "Run the large Rocketfuel AS 2914 prefix-scale table study for prefix counts 0,500,1000,1500,2000 in twophase and onephase",
  "run_root_template": "experiments/prefix_scale/results/rocketfuel_2914_bothphase_0to2000_by500_tables/{timestamp}",
  "jobs": [
    {
      "name": "build twophase and onephase",
      "cmd": "./run.sh build && ./run.sh --env onephase build"
    },
    {
      "name": "sim twophase rocketfuel 2914 0..2000 by 500",
      "cmd": "./run.sh sim --no-build prefix_scale --topology rocketfuel_2914 --prefix-counts 0 500 1000 1500 2000 --core-disable-prefix-egress-replication --adv-interval 1000 --dead-interval 3000 --window 15 --out {run_root}/twophase"
    },
    {
      "name": "sim onephase rocketfuel 2914 0..2000 by 500",
      "cmd": "./run.sh --env onephase sim --no-build prefix_scale --topology rocketfuel_2914 --prefix-counts 0 500 1000 1500 2000 --adv-interval 1000 --dead-interval 3000 --window 15 --out {run_root}/onephase"
    },
    {
      "name": "render rocketfuel 2914 plots and summary",
      "cmd": "./run.sh as-user python3 experiments/prefix_scale/plot.py --source-label sim --data {run_root}"
    }
  ]
}
