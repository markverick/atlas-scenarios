{
  "_comment": "ndndSIM prefix-scale study for onephase on core_edge (prefix counts: 0, 2000). Each run starts fresh. Run with: sudo ./jobs.sh start --fresh prefix_scale/core_edge_onephase_p0to2000by2000_bw1Mbps",
  "selector": "prefix_scale/core_edge_onephase_p0to2000by2000_bw1Mbps",
  "name": "core_edge_onephase_p0to2000by2000_bw1Mbps",
  "experiment": "prefix_scale",
  "topology": "core_edge",
  "mode": "onephase",
  "description": "core_edge prefix-scale study (onephase) for p=0,2000. Each run starts fresh.",
  "run_root_template": "experiments/prefix_scale/results/core_edge_onephase_p0to2000by2000_bw1Mbps/{timestamp}",
  "jobs": [
    {
      "name": "build",
      "cmd": "./run.sh --env onephase build"
    },
    {
      "name": "p=0 onephase",
      "cmd": "./run.sh --env onephase sim --no-build prefix_scale --topology core_edge --bw 1 --adv-interval 1000 --dead-interval 3000 --window 86400 --prefix-counts 0 --out {run_root}/p0"
    },
    {
      "name": "p=2000 onephase",
      "cmd": "./run.sh --env onephase sim --no-build prefix_scale --topology core_edge --bw 1 --adv-interval 1000 --dead-interval 3000 --window 86400 --prefix-counts 2000 --out {run_root}/p2000"
    }
  ]
}
