{
  "_comment": "ndndSIM prefix-scale study for twophase+onephase on rocketfuel_1755 (prefix counts: 0, 2000). Each run starts fresh. Run with: sudo ./jobs.sh start --fresh prefix_scale/rocketfuel_1755_bothphase_p0to2000by2000_bw1000Mbps_q1000_noceil",
  "selector": "prefix_scale/rocketfuel_1755_bothphase_p0to2000by2000_bw1000Mbps_q1000_noceil",
  "name": "rocketfuel_1755_bothphase_p0to2000by2000_bw1000Mbps_q1000_noceil",
  "experiment": "prefix_scale",
  "topology": "rocketfuel_1755",
  "mode": "twophase+onephase",
  "description": "rocketfuel_1755 prefix-scale study (twophase+onephase) for p=0,2000. Each run starts fresh.",
  "run_root_template": "experiments/prefix_scale/results/rocketfuel_1755_bothphase_p0to2000by2000_bw1000Mbps_q1000_noceil/{timestamp}",
  "jobs": [
    {
      "name": "build",
      "cmd": "./run.sh build && ./run.sh --env onephase build"
    },
    {
      "name": "p=0 twophase",
      "cmd": "./run.sh sim --no-build prefix_scale --topology rocketfuel_1755 --bw 1000 --queue-size 1000 --core-disable-prefix-egress-replication --adv-interval 1000 --dead-interval 3000 --window 86400 --prefix-counts 0 --out {run_root}/p0"
    },
    {
      "name": "p=0 onephase",
      "cmd": "./run.sh --env onephase sim --no-build prefix_scale --topology rocketfuel_1755 --bw 1000 --queue-size 1000 --adv-interval 1000 --dead-interval 3000 --window 86400 --prefix-counts 0 --out {run_root}/p0"
    },
    {
      "name": "p=2000 twophase",
      "cmd": "./run.sh sim --no-build prefix_scale --topology rocketfuel_1755 --bw 1000 --queue-size 1000 --core-disable-prefix-egress-replication --adv-interval 1000 --dead-interval 3000 --window 86400 --prefix-counts 2000 --out {run_root}/p2000"
    },
    {
      "name": "p=2000 onephase",
      "cmd": "./run.sh --env onephase sim --no-build prefix_scale --topology rocketfuel_1755 --bw 1000 --queue-size 1000 --adv-interval 1000 --dead-interval 3000 --window 86400 --prefix-counts 2000 --out {run_root}/p2000"
    },
    {
      "name": "plot: prefix scale",
      "cmd": "./run.sh as-user python3 experiments/prefix_scale/plot.py --data {run_root}"
    }
  ]
}
