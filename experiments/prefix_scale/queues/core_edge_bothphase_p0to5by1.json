{
  "_comment": "ndndSIM prefix-scale study for twophase+onephase on core_edge (prefix counts: 0, 1, 2, 3, 4, 5). Each run starts fresh. Run with: sudo ./jobs.sh start --fresh prefix_scale/core_edge_bothphase_p0to5by1",
  "selector": "prefix_scale/core_edge_bothphase_p0to5by1",
  "name": "core_edge_bothphase_p0to5by1",
  "experiment": "prefix_scale",
  "topology": "core_edge",
  "mode": "twophase+onephase",
  "description": "core_edge prefix-scale study (twophase+onephase) for p=0,1,2,3,4,5. Each run starts fresh.",
  "run_root_template": "experiments/prefix_scale/results/core_edge_bothphase_p0to5by1/{timestamp}",
  "jobs": [
    {
      "name": "build",
      "cmd": "./run.sh build && ./run.sh --env onephase build"
    },
    {
      "name": "p=0 twophase",
      "cmd": "./run.sh sim --no-build prefix_scale --topology core_edge --core-disable-prefix-egress-replication --window 86400 --prefix-counts 0 --out {run_root}/p0 --conv-window 5.2"
    },
    {
      "name": "p=0 onephase",
      "cmd": "./run.sh --env onephase sim --no-build prefix_scale --topology core_edge --window 86400 --prefix-counts 0 --out {run_root}/p0 --conv-window 5.2"
    },
    {
      "name": "p=1 twophase",
      "cmd": "./run.sh sim --no-build prefix_scale --topology core_edge --core-disable-prefix-egress-replication --window 86400 --prefix-counts 1 --out {run_root}/p1 --conv-window 5.2"
    },
    {
      "name": "p=1 onephase",
      "cmd": "./run.sh --env onephase sim --no-build prefix_scale --topology core_edge --window 86400 --prefix-counts 1 --out {run_root}/p1 --conv-window 5.2"
    },
    {
      "name": "p=2 twophase",
      "cmd": "./run.sh sim --no-build prefix_scale --topology core_edge --core-disable-prefix-egress-replication --window 86400 --prefix-counts 2 --out {run_root}/p2 --conv-window 5.2"
    },
    {
      "name": "p=2 onephase",
      "cmd": "./run.sh --env onephase sim --no-build prefix_scale --topology core_edge --window 86400 --prefix-counts 2 --out {run_root}/p2 --conv-window 5.2"
    },
    {
      "name": "p=3 twophase",
      "cmd": "./run.sh sim --no-build prefix_scale --topology core_edge --core-disable-prefix-egress-replication --window 86400 --prefix-counts 3 --out {run_root}/p3 --conv-window 5.2"
    },
    {
      "name": "p=3 onephase",
      "cmd": "./run.sh --env onephase sim --no-build prefix_scale --topology core_edge --window 86400 --prefix-counts 3 --out {run_root}/p3 --conv-window 5.2"
    },
    {
      "name": "p=4 twophase",
      "cmd": "./run.sh sim --no-build prefix_scale --topology core_edge --core-disable-prefix-egress-replication --window 86400 --prefix-counts 4 --out {run_root}/p4 --conv-window 5.2"
    },
    {
      "name": "p=4 onephase",
      "cmd": "./run.sh --env onephase sim --no-build prefix_scale --topology core_edge --window 86400 --prefix-counts 4 --out {run_root}/p4 --conv-window 5.2"
    },
    {
      "name": "p=5 twophase",
      "cmd": "./run.sh sim --no-build prefix_scale --topology core_edge --core-disable-prefix-egress-replication --window 86400 --prefix-counts 5 --out {run_root}/p5 --conv-window 5.2"
    },
    {
      "name": "p=5 onephase",
      "cmd": "./run.sh --env onephase sim --no-build prefix_scale --topology core_edge --window 86400 --prefix-counts 5 --out {run_root}/p5 --conv-window 5.2"
    },
    {
      "name": "render core-edge plots and summary",
      "cmd": "./run.sh as-user python3 experiments/prefix_scale/plot.py --source-label sim --data {run_root}"
    }
  ]
}
