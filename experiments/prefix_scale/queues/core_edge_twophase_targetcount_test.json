{
  "_comment": "Test: twophase target-count checker (stableWindow=0, targetNodes=numEdgeNodes) on core_edge. Verifies sim stops exactly when PET reaches expected count. sudo ./jobs.sh start --fresh prefix_scale/core_edge_twophase_targetcount_test",
  "selector": "prefix_scale/core_edge_twophase_targetcount_test",
  "name": "core_edge_twophase_targetcount_test",
  "experiment": "prefix_scale",
  "topology": "core_edge",
  "mode": "twophase",
  "description": "core_edge twophase with target-count convergence checker. No artificial ceiling; stops exactly when PET = baseline + numPrefixes x numEdgeNodes.",
  "run_root_template": "experiments/prefix_scale/results/core_edge_twophase_targetcount_test/{timestamp}",
  "jobs": [
    {
      "name": "build twophase",
      "cmd": "./run.sh build"
    },
    {
      "name": "stage1: DV convergence snapshot (twophase)",
      "cmd": "./run.sh sim --no-build prefix_scale --topology core_edge --prefix-counts 0 --core-disable-prefix-egress-replication --adv-interval 1000 --dead-interval 3000 --window 86400 --snap-export {run_root}/snap-stage1.json --out {run_root}/stage1"
    },
    {
      "name": "stage2: p0 baseline (twophase)",
      "cmd": "./run.sh sim --no-build prefix_scale --topology core_edge --prefix-counts 0 --core-disable-prefix-egress-replication --adv-interval 1000 --dead-interval 3000 --window 40 --snap-import {run_root}/snap-stage1.json --out {run_root}/stage2-p0"
    },
    {
      "name": "stage2: p5 (twophase, target-count)",
      "cmd": "./run.sh sim --no-build prefix_scale --topology core_edge --prefix-counts 5 --core-disable-prefix-egress-replication --adv-interval 1000 --dead-interval 3000 --window 86400 --snap-import {run_root}/snap-stage1.json --out {run_root}/stage2-p5"
    },
    {
      "name": "plot: prefix scale",
      "cmd": "./run.sh as-user python3 experiments/prefix_scale/plot.py --data {run_root} --source-label sim"
    },
    {
      "name": "plot: I/O graph",
      "cmd": "./run.sh as-user python3 experiments/prefix_scale/make_run_io_graph.py --data {run_root} --bw 10"
    }
  ]
}
