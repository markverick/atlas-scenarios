{
  "_comment": "Twophase-only at 1Gbps, queue=1000 pkts, no simTime ceiling. Stability-window checker stops p2000 when PET converges. sudo ./jobs.sh start --fresh prefix_scale/rocketfuel_1755_twophase_bw1000_noceil",
  "selector": "prefix_scale/rocketfuel_1755_twophase_bw1000_noceil",
  "name": "rocketfuel_1755_twophase_bw1000_noceil",
  "experiment": "prefix_scale",
  "topology": "rocketfuel_1755",
  "mode": "twophase",
  "description": "rocketfuel_1755 twophase only at bw=1000 Mbps, queue=1000 pkts, no simTime ceiling.",
  "run_root_template": "experiments/prefix_scale/results/rocketfuel_1755_twophase_bw1000_noceil/{timestamp}",
  "jobs": [
    {
      "name": "build twophase",
      "cmd": "./run.sh build"
    },
    {
      "name": "stage1: DV convergence snapshot (twophase)",
      "cmd": "./run.sh sim --no-build prefix_scale --topology rocketfuel_1755 --prefix-counts 0 --bw 1000 --queue-size 1000 --core-disable-prefix-egress-replication --adv-interval 1000 --dead-interval 3000 --window 86400 --snap-export {run_root}/snap-stage1-twophase.json --out {run_root}/stage1-twophase"
    },
    {
      "name": "stage2: p0 baseline (twophase)",
      "cmd": "./run.sh sim --no-build prefix_scale --topology rocketfuel_1755 --prefix-counts 0 --bw 1000 --queue-size 1000 --core-disable-prefix-egress-replication --adv-interval 1000 --dead-interval 3000 --window 40 --snap-import {run_root}/snap-stage1-twophase.json --out {run_root}/stage2-p0-twophase"
    },
    {
      "name": "stage2: p2000 (twophase)",
      "cmd": "./run.sh sim --no-build prefix_scale --topology rocketfuel_1755 --prefix-counts 2000 --bw 1000 --queue-size 1000 --core-disable-prefix-egress-replication --adv-interval 1000 --dead-interval 3000 --window 86400 --snap-import {run_root}/snap-stage1-twophase.json --out {run_root}/stage2-p2000-twophase"
    },
    {
      "name": "plot: prefix scale",
      "cmd": "./run.sh as-user python3 experiments/prefix_scale/plot.py --data {run_root} --source-label sim"
    },
    {
      "name": "plot: I/O graph",
      "cmd": "./run.sh as-user python3 experiments/prefix_scale/make_run_io_graph.py --data {run_root} --bw 1000"
    }
  ]
}
