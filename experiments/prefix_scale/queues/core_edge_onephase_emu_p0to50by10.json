{
  "_comment": "Core/edge emu prefix-scale study for twophase and onephase at 10-prefix steps. Run with: sudo ./jobs.sh start --fresh prefix_scale/core_edge_emu_bothphase_0to50_by10",
  "selector": "prefix_scale/core_edge_onephase_emu_p0to50by10",
  "name": "core_edge_onephase_emu_p0to50by10",
  "experiment": "prefix_scale",
  "topology": "core_edge",
  "mode": "twophase+onephase",
  "description": "Run the core/edge emu prefix-scale study for prefix counts 0,10,20,30,40,50 in twophase and onephase",
  "run_root_template": "experiments/prefix_scale/results/core_edge_onephase_emu_p0to50by10/{timestamp}",
  "jobs": [
    {
      "name": "build twophase and onephase binaries",
      "cmd": "./run.sh build && ./run.sh --env onephase build"
    },
    {
      "name": "emu twophase core-edge 0..50 by 10",
      "cmd": "./run.sh emu --no-build prefix_scale --prefix-counts 0 10 20 30 40 50 --out {run_root}/twophase"
    },
    {
      "name": "emu onephase core-edge 0..50 by 10",
      "cmd": "./run.sh --env onephase emu --no-build prefix_scale --prefix-counts 0 10 20 30 40 50 --out {run_root}/onephase"
    },
    {
      "name": "render core-edge plots and summary",
      "cmd": "./run.sh as-user python3 experiments/prefix_scale/plot.py --source-label emu --data {run_root}"
    }
  ]
}
