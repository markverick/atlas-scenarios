{
  "_comment": "Core/edge sim-only prefix-scale table study for twophase and onephase. Run with: sudo ./jobs.sh start --fresh prefix_scale/core_edge_bothphase_0to5_tables",
  "selector": "prefix_scale/core_edge_bothphase_0to5_tables",
  "name": "core_edge_bothphase_0to5_tables",
  "experiment": "prefix_scale",
  "topology": "core_edge",
  "mode": "twophase+onephase",
  "description": "Run the core/edge prefix-scale table study for prefix counts 0..5 in twophase and onephase",
  "run_root_template": "experiments/prefix_scale/results/core_edge_bothphase_0to5_tables/{timestamp}",
  "jobs": [
    {
      "name": "build twophase and onephase",
      "cmd": "./run.sh build && ./run.sh --env onephase build"
    },
    {
      "name": "sim twophase core-edge 0..5",
      "cmd": "./run.sh sim --no-build prefix_scale --prefix-counts 0 1 2 3 4 5 --out {run_root}/twophase"
    },
    {
      "name": "sim onephase core-edge 0..5",
      "cmd": "./run.sh --env onephase sim --no-build prefix_scale --prefix-counts 0 1 2 3 4 5 --out {run_root}/onephase"
    }
  ]
}