{
  "_comment": "Core/edge sim-only prefix-scale table study for twophase and onephase at 500-prefix steps. Run with: sudo ./jobs.sh start --fresh prefix_scale/core_edge_bothphase_0to2000_by500_tables",
  "selector": "prefix_scale/core_edge_bothphase_0to2000_by500_tables",
  "name": "core_edge_bothphase_0to2000_by500_tables",
  "experiment": "prefix_scale",
  "topology": "core_edge",
  "mode": "twophase+onephase",
  "description": "Run the core/edge prefix-scale table study for prefix counts 0,500,1000,1500,2000 in twophase and onephase",
  "run_root_template": "experiments/prefix_scale/results/core_edge_bothphase_0to2000_by500_tables/{timestamp}",
  "jobs": [
    {
      "name": "build twophase and onephase",
      "cmd": "./run.sh build && ./run.sh --env onephase build"
    },
    {
      "name": "sim twophase core-edge 0..2000 by 500",
      "cmd": "./run.sh sim --no-build prefix_scale --prefix-counts 0 500 1000 1500 2000 --core-disable-prefix-egress-replication --out {run_root}/twophase"
    },
    {
      "name": "sim onephase core-edge 0..2000 by 500",
      "cmd": "./run.sh --env onephase sim --no-build prefix_scale --prefix-counts 0 500 1000 1500 2000 --out {run_root}/onephase"
    },
    {
      "name": "render core-edge plots and summary",
      "cmd": "./run.sh as-user python3 experiments/prefix_scale/plot.py --data {run_root}"
    }
  ]
}
