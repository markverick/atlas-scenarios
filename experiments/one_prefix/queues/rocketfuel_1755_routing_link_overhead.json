{
  "selector": "one_prefix/rocketfuel_1755_routing_link_overhead",
  "name": "rocketfuel_1755 one-prefix routing link overhead",
  "topology": "rocketfuel_1755",
  "description": "Compare zero-prefix baseline with one introduced prefix after synthetic routing prep on Rocketfuel AS 1755",
  "run_root_template": "experiments/one_prefix/results/rocketfuel_1755_routing_link_overhead/{timestamp}",
  "jobs": [
    {
      "name": "build twophase",
      "cmd": "NDND_SKIP_TESTS=1 ./run.sh build-sim"
    },
    {
      "name": "twophase p0",
      "cmd": "./run.sh sim --no-build routing --topology rocketfuel_1755 --window 10 --synthetic-routing --total-prefixes 0 --out {run_root}/twophase/p0"
    },
    {
      "name": "twophase p1",
      "cmd": "./run.sh sim --no-build routing --topology rocketfuel_1755 --window 10 --synthetic-routing --total-prefixes 1 --out {run_root}/twophase/p1"
    },
    {
      "name": "build onephase",
      "cmd": "NDND_SKIP_TESTS=1 ./run.sh --env onephase build-sim"
    },
    {
      "name": "onephase p0",
      "cmd": "./run.sh --env onephase sim --no-build routing --topology rocketfuel_1755 --window 10 --synthetic-routing --total-prefixes 0 --out {run_root}/onephase/p0"
    },
    {
      "name": "onephase p1",
      "cmd": "./run.sh --env onephase sim --no-build routing --topology rocketfuel_1755 --window 10 --synthetic-routing --total-prefixes 1 --out {run_root}/onephase/p1"
    },
    {
      "name": "aggregate link overhead",
      "cmd": "./run.sh as-user python3 experiments/one_prefix/routing_link_overhead.py --data {run_root}"
    }
  ]
}
